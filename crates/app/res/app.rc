// Windows resources of the screensaver (plan 0001, Phase 1 task 10;
// plan 0002, T-1). Compiled by build.rs with embed-resource.
//
// Why no #include <windows.h>/<winver.h>: the constants below are the only
// ones used, and without system headers the file also compiles with llvm-rc
// on Linux hosts, where those headers do not exist.

#pragma code_page(65001)

// fm_version.h is generated by build.rs from Cargo.toml (no second copy of
// the version). It defines FM_VERSION_BIN, FM_VERSION_STR and FM_FILEFLAGS.
#include "fm_version.h"

// winver.h
#define VS_VERSION_INFO 1
#define VS_FFI_FILEFLAGSMASK 0x3FL
#define VOS_NT_WINDOWS32 0x40004L
#define VFT_APP 0x1L
#define VFT2_UNKNOWN 0x0L

// scrnsave.h: the icon of a screen saver has the ID ID_APP, and its
// description is string 1 (IDS_DESCRIPTION). docs/research/windows-screensaver.md
#define ID_APP 100
#define IDS_DESCRIPTION 1

ID_APP ICON "flying-microwave.ico"

STRINGTABLE
BEGIN
    // Same as the file name, which Windows shows in the screen saver list
    // (docs/research/windows-screensaver.md).
    IDS_DESCRIPTION "FlyingMicrowave"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION FM_VERSION_BIN
PRODUCTVERSION FM_VERSION_BIN
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS FM_FILEFLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // U.S. English, Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Flying Microwave screensaver"
            VALUE "FileVersion", FM_VERSION_STR
            VALUE "InternalName", "flying-microwave"
            VALUE "LegalCopyright", "Copyright (c) 2026 Flying Microwave contributors. MIT License."
            VALUE "OriginalFilename", "FlyingMicrowave.scr"
            VALUE "ProductName", "Flying Microwave"
            VALUE "ProductVersion", FM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
